{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Master Team dispatch v2",
  "type": "object",
  "required": [
    "task_id",
    "ticket_id",
    "attempt_id",
    "master_session_id",
    "master_generation",
    "worker_id",
    "worker_session_id",
    "candidate_ref",
    "goal",
    "reads",
    "writes",
    "record_ref"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "ticket_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "master_session_id": {
      "type": "string",
      "minLength": 1
    },
    "worker_id": {
      "type": "string",
      "minLength": 1
    },
    "worker_session_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_ref": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "record_ref": {
      "type": "string",
      "minLength": 1
    },
    "master_generation": {
      "type": "integer",
      "minimum": 0
    },
    "reads": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "writes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
