{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Master Team conversational onboarding state",
  "type": "object",
  "required": ["schema_version", "skill_version", "learner_scope", "project_root", "platform", "auto_start", "status", "current_step", "completed_steps", "skipped_steps", "context", "last_prompt_key", "updated_at"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "skill_version": {"type": "string", "minLength": 1},
    "learner_scope": {"type": ["string", "null"]},
    "project_root": {"type": ["string", "null"]},
    "platform": {"enum": ["codex", "dsh", "claude", "unverified"]},
    "auto_start": {"type": "boolean"},
    "status": {"enum": ["not_started", "in_progress", "paused", "completed", "dismissed"]},
    "current_step": {"enum": ["purpose", "environment", "roles", "setup", "practice", "first_task", "finished"]},
    "completed_steps": {"type": "array", "items": {"enum": ["purpose", "environment", "roles", "setup", "practice", "first_task"]}},
    "skipped_steps": {"type": "array", "items": {"enum": ["purpose", "environment", "roles", "setup", "practice", "first_task"]}},
    "context": {
      "type": "object",
      "required": ["goal", "team_exists", "role_profile", "coordination_mode", "learning_only"],
      "properties": {
        "goal": {"type": ["string", "null"]},
        "team_exists": {"type": ["boolean", "null"]},
        "role_profile": {"enum": [null, "minimal", "software-six", "custom"]},
        "coordination_mode": {"enum": [null, "persistent", "parent_scoped", "manual"]},
        "learning_only": {"type": ["boolean", "null"]}
      }
    },
    "last_prompt_key": {"type": ["string", "null"]},
    "updated_at": {"type": ["string", "null"]}
  }
}
