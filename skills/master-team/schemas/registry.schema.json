{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Master Team registry v2",
  "type": "object",
  "required": [
    "schema_version",
    "protocol_version",
    "mode",
    "project_root",
    "host_id",
    "platform",
    "active_master_thread_id",
    "previous_master_thread_id",
    "handoff_status",
    "generation",
    "policy",
    "capabilities",
    "workers",
    "tickets",
    "write_claims",
    "handoff"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "protocol_version": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "persistent",
        "parent_scoped",
        "manual"
      ]
    },
    "project_root": {
      "type": [
        "string",
        "null"
      ]
    },
    "host_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "platform": {
      "enum": [
        "codex",
        "dsh",
        "claude",
        "unverified"
      ]
    },
    "active_master_thread_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "previous_master_thread_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "handoff_status": {
      "enum": [
        "unbound",
        "none",
        "requested",
        "quiescing",
        "completed",
        "blocked"
      ]
    },
    "policy": {
      "type": "object",
      "required": [
        "role_profile",
        "master_can_execute",
        "message_budget_bytes",
        "hard_message_limit_bytes",
        "max_review_rounds",
        "wait_slice_seconds"
      ],
      "properties": {
        "role_profile": {
          "enum": [
            "minimal",
            "software-six",
            "custom"
          ]
        },
        "master_can_execute": {
          "type": "boolean"
        },
        "message_budget_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "hard_message_limit_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "max_review_rounds": {
          "type": "integer",
          "minimum": 1
        },
        "wait_slice_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        }
      }
    },
    "capabilities": {
      "type": "object",
      "required": [
        "independent_sessions",
        "parent_scoped_agents",
        "message",
        "wait",
        "stop",
        "shared_files",
        "transfer_control"
      ],
      "properties": {
        "independent_sessions": {
          "enum": [
            "unverified",
            "available",
            "unavailable"
          ]
        },
        "parent_scoped_agents": {
          "enum": [
            "unverified",
            "available",
            "unavailable"
          ]
        },
        "message": {
          "enum": [
            "unverified",
            "available",
            "unavailable"
          ]
        },
        "wait": {
          "enum": [
            "unverified",
            "available",
            "unavailable"
          ]
        },
        "stop": {
          "enum": [
            "unverified",
            "available",
            "unavailable"
          ]
        },
        "shared_files": {
          "enum": [
            "unverified",
            "available",
            "unavailable"
          ]
        },
        "transfer_control": {
          "enum": [
            "unverified",
            "available",
            "unavailable"
          ]
        }
      }
    },
    "workers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "session_id",
          "host_id",
          "role",
          "session_kind",
          "transport",
          "parent_session_id",
          "verified",
          "active_ticket"
        ],
        "properties": {
          "session_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "host_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "session_kind": {
            "enum": [
              "independent",
              "child",
              "manual",
              "unbound",
              "legacy_unverified"
            ]
          },
          "transport": {
            "type": "string",
            "minLength": 1
          },
          "parent_session_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "verified": {
            "type": "boolean"
          },
          "active_ticket": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "ticket_id",
                  "attempt_id"
                ],
                "properties": {
                  "ticket_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "attempt_id": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          }
        }
      }
    },
    "tickets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "task_id",
          "current_attempt",
          "attempts"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "current_attempt": {
            "type": "string",
            "minLength": 1
          },
          "attempts": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "required": [
                "master_session_id",
                "master_generation",
                "worker_id",
                "candidate_ref",
                "goal",
                "reads",
                "writes",
                "depends_on",
                "delivery",
                "execution",
                "runtime",
                "acceptance",
                "report_ref"
              ],
              "properties": {
                "master_session_id": {
                  "type": "string",
                  "minLength": 1
                },
                "master_generation": {
                  "type": "integer",
                  "minimum": 0
                },
                "worker_id": {
                  "type": "string",
                  "minLength": 1
                },
                "candidate_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "goal": {
                  "type": "string",
                  "minLength": 1
                },
                "reads": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "writes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "depends_on": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "ticket_id",
                      "attempt_id"
                    ],
                    "properties": {
                      "ticket_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "attempt_id": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                },
                "delivery": {
                  "enum": [
                    "not_sent",
                    "pending_delivery",
                    "submitted",
                    "acknowledged",
                    "unknown"
                  ]
                },
                "execution": {
                  "enum": [
                    "planned",
                    "running",
                    "submitted",
                    "blocked",
                    "error",
                    "stopped"
                  ]
                },
                "runtime": {
                  "enum": [
                    "unknown",
                    "idle",
                    "running",
                    "ended"
                  ]
                },
                "acceptance": {
                  "enum": [
                    "pending",
                    "accepted",
                    "rejected"
                  ]
                },
                "report_ref": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "write_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ticket_id",
          "attempt_id",
          "path"
        ],
        "properties": {
          "ticket_id": {
            "type": "string",
            "minLength": 1
          },
          "attempt_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "handoff": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
